{
  "name": "epub-reader-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply epub_reader_db --remote",
    "db:migrate:local": "wrangler d1 migrations apply epub_reader_db --local",
    "build:server": "esbuild server/node.ts --bundle --platform=node --format=esm --target=node24 --external:node:sqlite --outfile=dist/server.mjs",
    "start:server": "node --disable-warning=ExperimentalWarning dist/server.mjs",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "fast-xml-parser": "^4.5.1",
    "fflate": "^0.8.2",
    "hono": "^4.6.14",
    "htmlparser2": "^9.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^26.6.2",
    "@vscode/codicons": "^0.0.46-24",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.4.0"
  }
}
